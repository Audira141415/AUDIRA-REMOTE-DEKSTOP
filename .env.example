# ==============================================================================
# AUDIRA Remote Desktop — Environment Variables Template
# Copy this file to .env and configure your secrets.
# NEVER commit the .env file to public Git repositories!
# ==============================================================================

# Remote Server SSH Deployment
AUDIRA_SSH_HOST=192.168.100.175
AUDIRA_SSH_PORT=22
AUDIRA_SSH_USER=audira
AUDIRA_SSH_PASS=

# Telegram Operations & Fleet Bot
AUDIRA_TELEGRAM_BOT_TOKEN=
AUDIRA_TELEGRAM_CHAT_ID=-1003961181911
AUDIRA_TELEGRAM_THREAD_ID=2
AUDIRA_API_URL=http://127.0.0.1:5050

# Cloudflare DDNS
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=audira.my.id
CLOUDFLARE_RECORD=desk.audira.my.id
